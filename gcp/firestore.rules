rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the project
    function isProjectOwner(projectId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
    }

    // Helper function to check if user is a project member
    function isProjectMember(projectId) {
      let project = get(/databases/$(database)/documents/projects/$(projectId)).data;
      return isAuthenticated() && (
        project.ownerId == request.auth.uid ||
        request.auth.uid in project.members[*].userId
      );
    }

    // Helper function to check if user can edit project
    function canEditProject(projectId) {
      let project = get(/databases/$(database)/documents/projects/$(projectId)).data;
      return isAuthenticated() && (
        project.ownerId == request.auth.uid ||
        project.members.hasAny([
          {'userId': request.auth.uid, 'role': 'editor'},
          {'userId': request.auth.uid, 'role': 'owner'}
        ])
      );
    }

    // Users collection
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isAuthenticated() && request.auth.uid == userId;
      // Users can create/update their own profile
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Projects collection
    match /projects/{projectId} {
      // Allow read if user is owner or member
      allow read: if isProjectMember(projectId);

      // Allow create if authenticated
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid;

      // Allow update if user can edit
      allow update: if canEditProject(projectId);

      // Allow delete only for owner
      allow delete: if isProjectOwner(projectId);

      // Tasks subcollection
      match /tasks/{taskId} {
        // Allow read if user is project member
        allow read: if isProjectMember(projectId);

        // Allow write if user can edit project
        allow write: if canEditProject(projectId);
      }
    }
  }
}
