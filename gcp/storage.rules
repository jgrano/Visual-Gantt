rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Exports folder - users can read their own exports
    match /exports/{projectId}/{filename} {
      // Allow read if authenticated (signed URLs handle actual access)
      allow read: if isAuthenticated();

      // Allow write from Cloud Functions only (service account)
      allow write: if false;
    }

    // Default deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
